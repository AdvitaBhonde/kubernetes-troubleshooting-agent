# Application Configuration
APP_NAME="AI-Powered Kubernetes Troubleshooting Agent"
DEBUG=false
DEFAULT_NAMESPACE=default

# Cluster Connection (Leave blank for in-cluster or automatic ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig
DEMO_MODE=false

# Log & Event Collection Limits
MAX_LOG_LINES=150
MAX_EVENTS=50

# AI Provider Selection: 'rules' (default zero-cost offline), 'bedrock', or 'openai'
AI_PROVIDER=rules

# AWS Bedrock Configuration (Optional - only required if AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS credentials should be supplied via IAM role, AWS_ACCESS_KEY_ID, or ~/.aws/credentials
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# OpenAI Configuration (Optional - only required if AI_PROVIDER=openai)
# OPENAI_API_KEY=your_api_key
# OPENAI_MODEL=gpt-4o-mini
